<?xml
    version="1.1"
    encoding="UTF-8"
    standalone="no"
?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
    <!--
        TCOTA-881: the LMS accounts (a school's Canvas, by its root account) that may use Terracotta
        through a self-service registration, such as Canvas's "1.3 Dynamic Registration". An account
        has every address its LMS is reached at, so a school's own domain works as well as its
        instructure.com one. A registration from an address no approved account has is kept, but
        its platform deployment (iss_configuration.lms_approved_account_id) can't launch until
        Terracotta staff approve the account.
    -->
    <changeSet author="rlong" id="1794960000000-01">
        <createTable tableName="lms_approved_account">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="uuid" type="BINARY(16)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UQ1794960000000-01"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="lms_connector" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="approved" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="platform_guid" type="VARCHAR(255)"/>
            <column name="approved_by" type="VARCHAR(255)"/>
            <column name="approved_at" type="datetime"/>
            <column name="entity_version" type="INT"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_at" type="timestamp"/>
            <column name="updated_at" type="datetime"/>
        </createTable>

        <createTable tableName="lms_approved_account_host">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="uuid" type="BINARY(16)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UQ1794960000000-02"/>
            </column>
            <column name="host" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UQ1794960000000-03"/>
            </column>
            <column name="lms_approved_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="entity_version" type="INT"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_at" type="timestamp"/>
            <column name="updated_at" type="datetime"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="lms_approved_account_id" baseTableName="lms_approved_account_host" constraintName="FK1794960000000-01" deferrable="false" initiallyDeferred="false" onDelete="CASCADE" onUpdate="RESTRICT" referencedColumnNames="id" referencedTableName="lms_approved_account" validate="true"/>

        <addColumn tableName="iss_configuration">
            <column name="lms_approved_account_id" type="BIGINT"/>
        </addColumn>

        <!-- RESTRICT: deleting an account would let its deployments launch unchecked -->
        <addForeignKeyConstraint baseColumnNames="lms_approved_account_id" baseTableName="iss_configuration" constraintName="FK1794960000000-02" deferrable="false" initiallyDeferred="false" onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id" referencedTableName="lms_approved_account" validate="true"/>
    </changeSet>

    <!--
        Every Canvas Terracotta already has stays able to register: one approved account per Canvas
        address in iss_configuration.base_url (e.g. https://iu.instructure.com -> iu.instructure.com),
        named after it. Their existing deployments stay unlinked, so they launch exactly as before.
    -->
    <changeSet author="rlong" id="1794960000000-02" dbms="mysql">
        <sql>
            INSERT INTO lms_approved_account (uuid, name, lms_connector, approved, approved_by, approved_at, entity_version, created_at, updated_at)
            SELECT
                UUID_TO_BIN(UUID()),
                hosts.host,
                'CANVAS',
                TRUE,
                'migration',
                NOW(),
                0,
                NOW(),
                NOW()
            FROM (
                SELECT DISTINCT LOWER(SUBSTRING_INDEX(SUBSTRING_INDEX(SUBSTRING_INDEX(TRIM(base_url), '://', -1), '/', 1), ':', 1)) AS host
                FROM iss_configuration
                WHERE lms_connector = 'CANVAS'
                    AND base_url IS NOT NULL
                    AND TRIM(base_url) != ''
            ) hosts
            WHERE hosts.host != '';

            INSERT INTO lms_approved_account_host (uuid, host, lms_approved_account_id, entity_version, created_at, updated_at)
            SELECT UUID_TO_BIN(UUID()), name, id, 0, NOW(), NOW()
            FROM lms_approved_account
            WHERE approved_by = 'migration';
        </sql>

        <rollback>
            <sql>
                DELETE FROM lms_approved_account WHERE approved_by = 'migration';
            </sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
